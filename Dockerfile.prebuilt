
FROM debian:bookworm-slim

ARG TARGETARCH
ARG TT_VERSION=1.1.0

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates curl tar iproute2 bash && \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "$TARGETARCH" in \
      arm64) TT_ARCH=aarch64 ;; \
      amd64) TT_ARCH=x86_64 ;; \
      *) echo "Unsupported architecture: $TARGETARCH"; exit 1 ;; \
    esac; \
    FILE="trusttunnel-v${TT_VERSION}-linux-${TT_ARCH}.tar.gz"; \
    curl -fL --retry 3 \
      "https://github.com/TrustTunnel/TrustTunnel/releases/download/v${TT_VERSION}/${FILE}" \
      -o /tmp/trusttunnel.tar.gz; \
    mkdir -p /tmp/tt; \
    tar -xzf /tmp/trusttunnel.tar.gz -C /tmp/tt; \
    find /tmp/tt -type f -name trusttunnel_endpoint \
      -exec cp {} /usr/local/bin/trusttunnel_endpoint \;; \
    find /tmp/tt -type f -name setup_wizard \
      -exec cp {} /usr/local/bin/setup_wizard \;; \
    test -s /usr/local/bin/trusttunnel_endpoint; \
    test -s /usr/local/bin/setup_wizard; \
    chmod +x /usr/local/bin/trusttunnel_endpoint \
             /usr/local/bin/setup_wizard; \
    rm -rf /tmp/tt /tmp/trusttunnel.tar.gz

COPY docker-entrypoint.sh /scripts/docker-entrypoint.sh
RUN chmod +x /scripts/docker-entrypoint.sh

WORKDIR /trusttunnel_endpoint

ENTRYPOINT ["/scripts/docker-entrypoint.sh"]
